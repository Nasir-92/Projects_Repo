<UserControl x:Class="EcoBite.Views.RestauranteVista"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>

        <Grid.Background>
            <ImageBrush ImageSource="/Assets/fondo.png"
                        Stretch="UniformToFill"/>
        </Grid.Background>

        <Rectangle Fill="#663C7E64"/>

        <Grid Margin="40">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- CARD GRANDE -->
            <Border Grid.Row="1"
                    MaxWidth="1200"
                    Background="White"
                    CornerRadius="22"
                    Padding="45"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="20">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="30"
                                      ShadowDepth="5"
                                      Opacity="0.35"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Vertical">
                        <!-- HEADER-->
                        <Grid  Grid.Row="0" Margin="0,0,0,25" >

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- BOTON VOLVER -->
                            <Button Content="←"
                                    Width="45"
                                    Height="45"
                                    FontSize="20"
                                    Background="#22FFFFFF"
                                    BorderThickness="0"
                                    Foreground="Black"
                                    Command="{Binding VolverCommand}"/>

                            <!-- LOGO -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">

                                <Grid Width="100" Height="100">

                                    <Ellipse Fill="White" Margin="0,0,10,10"/>

                                    <Ellipse Fill="#2E7D32"
                                             HorizontalAlignment="Right"
                                             Width="90"
                                             Margin="0,0,10,19">

                                        <Ellipse.OpacityMask>
                                            <ImageBrush ImageSource="/Assets/logo.png"
                                                        Stretch="Uniform"/>
                                        </Ellipse.OpacityMask>

                                    </Ellipse>

                                </Grid>

                            </StackPanel>

                            <!-- Menú usuario -->
                            <Grid Grid.Column="2">

                                <ToggleButton x:Name="MenuUsuarioBtn"
                                              Width="40"
                                              Height="40"
                                              FontSize="18"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Content="👤"/>

                                <Popup PlacementTarget="{Binding ElementName=MenuUsuarioBtn}"
                                       Placement="Bottom"
                                       StaysOpen="False"
                                       IsOpen="{Binding IsChecked, ElementName=MenuUsuarioBtn}">

                                    <Border Background="White"
                                            CornerRadius="10"
                                            Padding="10"
                                            Width="160"
                                            BorderBrush="#DDD"
                                            BorderThickness="1">

                                        <StackPanel>

                                            <Button Content="⚙ Configuración"
                                                    Margin="0,0,0,5"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding IrAConfiguracionCommand}"/>

                                            <Button Content="ℹ Acerca de"
                                                    Margin="0,0,0,5"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding IrAAcercaDeCommand}"/>

                                            <Separator/>

                                            <Button Content="🚪 Cerrar sesión"
                                                    Margin="0,5,0,0"
                                                    Background="#C62828"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    Padding="6"
                                                    Command="{Binding CerrarSesionCommand}"/>

                                        </StackPanel>
                                    </Border>

                                </Popup>

                            </Grid>

                        </Grid>
                        <!--HEADER-->


                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.6*"/>
                                <ColumnDefinition Width="2.4*"/>
                            </Grid.ColumnDefinitions>


                            <!-- RESTAURANTE -->
                            <StackPanel Margin="0,0,40,0">

                                <TextBlock Text="{Binding Restaurante.Nombre}"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="#2E7D32"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,20"/>

                                <Border Height="180"
                                        CornerRadius="14"
                                        Background="#EEE"
                                        Margin="0,0,0,20"
                                        ClipToBounds="True">

                                    <Image Source="{Binding Restaurante.Imagen,
                                           Converter={StaticResource Base64ToImageConverter}}"
                                           Stretch="UniformToFill"/>

                                </Border>

                                <TextBlock Text="Información"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Margin="0,0,0,10"/>

                                <TextBlock Text="{Binding Restaurante.Descripcion}"
                                           TextWrapping="Wrap"
                                           FontSize="15"
                                           Foreground="#444"/>

                            </StackPanel>



                            <!-- RECETA -->
                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Center">

                                <TextBlock Text="Carta del restaurante"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#2E7D32"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,25"/>

                                <Grid HorizontalAlignment="Center">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="520"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>


                                    <Button Grid.Column="0"
                                            Content="◀"
                                            Command="{Binding AnteriorRecetaCommand}"
                                            Background="#2E7D32"
                                            Foreground="White"
                                            Width="50"
                                            Height="50"
                                            BorderThickness="0"
                                            Margin="0,0,20,0"/>


                                    <Border Grid.Column="1"
                                            CornerRadius="18"
                                            Background="#EEE"
                                            Height="320"
                                            Padding="12">

                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="22"
                                                              ShadowDepth="3"
                                                              Opacity="0.3"/>
                                        </Border.Effect>


                                        <Button Command="{Binding AbrirRecetaCommand}" BorderThickness="0" Background="Transparent">
                                            <Image Source="{Binding RecetaActual.Imagen,
                                                   Converter={StaticResource Base64ToImageConverter}}"
                                                   Stretch="UniformToFill"/>
                                        </Button>

                                    </Border>


                                    <Button Grid.Column="2"
                                            Content="▶"
                                            Command="{Binding SiguienteRecetaCommand}"
                                            Background="#2E7D32"
                                            Foreground="White"
                                            Width="50"
                                            Height="50"
                                            BorderThickness="0"
                                            Margin="20,0,0,0"/>

                                </Grid>

                            </StackPanel>

                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>

    </Grid>

</UserControl>