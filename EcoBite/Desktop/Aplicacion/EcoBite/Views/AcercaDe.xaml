<UserControl x:Class="EcoBite.Views.AcercaDe"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:EcoBite.ViewModels"
        mc:Ignorable="d"
       >

    <UserControl.DataContext>
        <vm:AcercaDeVM/>
    </UserControl.DataContext>

    <Grid>

        <!-- Fondo -->
        <Grid.Background>
            <ImageBrush ImageSource="/Assets/fondo.png"
                        Stretch="UniformToFill"/>
        </Grid.Background>

        <!-- Overlay -->
        <Rectangle Fill="#663C7E64"/>

        <!-- Tarjeta -->
        <Border Background="White"
                CornerRadius="20"
                Padding="30"
                Width="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="25"
                                  ShadowDepth="4"
                                  Opacity="0.35"/>
            </Border.Effect>

            <StackPanel>

                <!-- HEADER -->
                <Grid Margin="0,0,0,20">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Botón volver -->
                    <Button Content="←"
                            Width="40"
                            Height="40"
                            FontSize="18"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding IrAPrincipalCommand}"/>

                    <!-- Logo -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <Grid Width="90" Height="90">

                            <Ellipse Fill="White" Margin="0,0,10,10"/>

                            <Ellipse Fill="#2E7D32"
                                     HorizontalAlignment="Right"
                                     Width="80"
                                     Margin="0,0,10,19">

                                <Ellipse.OpacityMask>
                                    <ImageBrush ImageSource="/Assets/logo.png"
                                                Stretch="Uniform"/>
                                </Ellipse.OpacityMask>

                            </Ellipse>

                        </Grid>
                    </StackPanel>

                    <!-- Configuración -->
                    <Button Grid.Column="2"
                            Content="⚙"
                            Width="40"
                            Height="40"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding IrAConfiguracionCommand}"/>

                </Grid>

                <!-- Título -->
                <TextBlock Text="Nuestra historia"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#2E7D32"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>

                <!-- Texto -->
                <TextBlock Text="Todo comenzó el 29 / 10 / 2025..."
                           TextAlignment="Center"
                           FontSize="14"
                           Margin="0,0,0,5"/>

                <TextBlock Text="EcoBite nace con la misión de ofrecer alimentos sostenibles y saludables, cuidando el planeta en cada paso."
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           FontSize="13"
                           Foreground="#444"
                           Margin="0,0,0,20"/>

                <Separator Margin="0,5"/>

                <!-- Equipo -->
                <TextBlock Text="Nuestro equipo"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,5"/>

                <TextBlock Text="Alejandro · Nazir · Jose · Franco"
                           FontSize="13"
                           TextAlignment="Center"
                           Margin="0,0,0,15"/>

                <Separator Margin="0,5"/>

                <!-- Contacto -->
                <TextBlock Text="Contacto"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,5"/>

                <TextBlock Text="+34 777 888 999"
                           FontSize="13"
                           TextAlignment="Center"/>

                <TextBlock Text="contacto@ecobite.com"
                           FontSize="13"
                           TextAlignment="Center"
                           Margin="0,2,0,0"/>

            </StackPanel>

        </Border>

    </Grid>


</UserControl>