<UserControl x:Class="EcoBite.Views.RecetaVista"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>

        <!-- Fondo -->
        <Grid.Background>
            <ImageBrush ImageSource="/Assets/fondo.png"
                        Stretch="UniformToFill"/>
        </Grid.Background>

        <!-- Overlay -->
        <Rectangle Fill="#663C7E64"/>

        <Grid Margin="40">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>






            <!-- CARD PRINCIPAL -->
            <Border Grid.Row="1"
                    MaxWidth="900"
                    Padding="35"
                    CornerRadius="22"
                    Background="#F2F2F2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="25"
                                      ShadowDepth="6"
                                      Opacity="0.35"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Vertical">
                        <!-- HEADER-->
                        <Grid  Grid.Row="0" Margin="0,0,0,25" >

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- BOTON VOLVER -->
                            <Button Content="←"
                                    Width="45"
                                    Height="45"
                                    FontSize="20"
                                    Background="#22FFFFFF"
                                    BorderThickness="0"
                                    Foreground="Black"
                                    Command="{Binding VolverCommand}"/>

                            <!-- LOGO -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">

                                <Grid Width="100" Height="100">

                                    <Ellipse Fill="White" Margin="0,0,10,10"/>

                                    <Ellipse Fill="#2E7D32"
                                             HorizontalAlignment="Right"
                                             Width="90"
                                             Margin="0,0,10,19">

                                        <Ellipse.OpacityMask>
                                            <ImageBrush ImageSource="/Assets/logo.png"
                                                        Stretch="Uniform"/>
                                        </Ellipse.OpacityMask>

                                    </Ellipse>

                                </Grid>

                            </StackPanel>

                            <!-- Menú usuario -->
                            <Grid Grid.Column="2">

                                <ToggleButton x:Name="MenuUsuarioBtn"
                                              Width="40"
                                              Height="40"
                                              FontSize="18"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Content="👤"/>

                                <Popup PlacementTarget="{Binding ElementName=MenuUsuarioBtn}"
                                       Placement="Bottom"
                                       StaysOpen="False"
                                       IsOpen="{Binding IsChecked, ElementName=MenuUsuarioBtn}">

                                    <Border Background="White"
                                            CornerRadius="10"
                                            Padding="10"
                                            Width="160"
                                            BorderBrush="#DDD"
                                            BorderThickness="1">

                                        <StackPanel>

                                            <Button Content="⚙ Configuración"
                                                    Margin="0,0,0,5"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding IrAConfiguracionCommand}"/>

                                            <Button Content="ℹ Acerca de"
                                                    Margin="0,0,0,5"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding IrAAcercaDeCommand}"/>

                                            <Button Content="🗑 Eliminar"
                                                    Margin="0,0,0,5"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding EliminarCommand}"/>
                                            <!--Visibility="{Binding PuedeEliminar, Converter={StaticResource BoolToVisibilityConverter}}" />-->

                                            <Separator/>

                                            <Button Content="🚪 Cerrar sesión"
                                                    Margin="0,5,0,0"
                                                    Background="#C62828"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    Padding="6"
                                                    Command="{Binding CerrarSesionCommand}"/>

                                        </StackPanel>
                                    </Border>

                                </Popup>

                            </Grid>

                        </Grid>
                        <!--HEADER-->

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>


                            <!-- IMAGEN RECETA -->
                            <Border Grid.Row="0"
                                    CornerRadius="15"
                                    Height="320"
                                    Margin="0,0,0,20"
                                    ClipToBounds="True">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <Image Source="{Binding Receta.Imagen,
                                           Converter={StaticResource Base64ToImageConverter}}"
                                           Stretch="UniformToFill"/>
                                </ScrollViewer>
                            </Border>


                            <!-- NOMBRE -->
                            <TextBlock Grid.Row="1"
                                       Text="{Binding Receta.Nombre}"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#2E7D32"
                                       Margin="0,0,0,10"/>


                            <!-- CONTENIDO -->
                            <Grid Grid.Row="2">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>


                                <!-- DESCRIPCIÓN -->
                                <TextBlock Text="{Binding Receta.Descripcion}"
                                           TextWrapping="Wrap"
                                           FontSize="15"
                                           Foreground="#333"
                                           Margin="0,0,20,0"/>


                                <!-- RESTAURANTE -->
                                <Border Grid.Column="1"
                                        Background="#EAEAEA"
                                        CornerRadius="14"
                                        Padding="10">

                                    <StackPanel>

                                        <TextBlock Text="Restaurante"
                                                   FontWeight="Bold"
                                                   FontSize="16"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,10"/>

                                        <Border Height="90"
                                                CornerRadius="10"
                                                ClipToBounds="True">


                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <Button Command="{Binding AbrirRestauranteCommand}" BorderThickness="0" Background="Transparent">

                                                    <Image Source="{Binding Restaurante.Imagen,
                                                           Converter={StaticResource Base64ToImageConverter}}"
                                                           Stretch="UniformToFill"/>
                                                </Button>
                                            </ScrollViewer>
                                        </Border>

                                        <TextBlock Text="{Binding Restaurante.Nombre}"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,10,0,0"/>

                                    </StackPanel>

                                </Border>

                            </Grid>

                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>

    </Grid>

</UserControl>