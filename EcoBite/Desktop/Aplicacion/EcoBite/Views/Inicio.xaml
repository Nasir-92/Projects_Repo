<UserControl x:Class="EcoBite.Views.Inicio"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:EcoBite.Views"
             xmlns:vm="clr-namespace:EcoBite.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800" Cursor=""

             >
    <UserControl.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding LoginCommand}"/>
    </UserControl.InputBindings>
    <UserControl.DataContext>
        <vm:InicioVM/>
    </UserControl.DataContext>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Assets/fondo.png" Stretch="UniformToFill"/>
        </Grid.Background>

        <!-- Contenedor central -->
        <Border Background="#AAFFFFFF"
                CornerRadius="20"


                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">

                <Image Source="/Assets/logo.png"
                       Width="100" Height="100"
                       />

                <TextBlock Text="Email"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 5"/>
                <TextBox
                    Padding="0"
                    Height="40"
                    Width="300"
                    FontSize="15"
                    TextAlignment="Left"
                    VerticalContentAlignment="Center"
                    BorderBrush="#4CAF50"
                    BorderThickness="2"
                    Background="White"
                    Margin="0 0 0 20"
                    Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Contraseña -->
                <TextBlock Text="Contraseña"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 5"/>
                <PasswordBox
                    Height="40"
                    Width="300"
                    FontSize="15"
                    Padding="0"
                    VerticalContentAlignment="Center"
                    BorderBrush="#4CAF50"
                    BorderThickness="2"
                    Background="White"
                    Margin="0 0 0 30"
                    PasswordChanged="PasswordChanged"/>

                <!-- Botón Login -->
                <Button Content="Login"
                        Width="123"
                        Height="49"
                        FontSize="20"
                        FontWeight="Bold"
                        Background="#5ECF85"
                        Foreground="White"
                        BorderBrush="#4CAF50"
                        BorderThickness="2"
                        Cursor="Hand"
                        Margin="0 0 0 30"
                        Command="{Binding LoginCommand}"/>

                <!-- Enlaces -->
                <StackPanel>
                    <TextBlock Text="Crear cuenta"
                               HorizontalAlignment="Center"
                               Foreground="#0D6EFD"
                               FontSize="16"
                               Cursor="Hand"
                               Margin="0 0 0 10">
                        <TextBlock.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding IrACrearCuentaCommand}" />
                        </TextBlock.InputBindings>
                    </TextBlock>

                    <TextBlock Text="Recuperar contraseña"
                               HorizontalAlignment="Center"
                               Foreground="#0D6EFD"
                               FontSize="16"
                               Cursor="Hand">

                        <TextBlock.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding IrARecuperarCuentaCommand}" />
                        </TextBlock.InputBindings>

                    </TextBlock>
                </StackPanel>

            </StackPanel>
        </Border>

    </Grid>
</UserControl>
