<UserControl x:Class="EcoBite.Views.IntroducirCodigo"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:EcoBite.ViewModels">

    <UserControl.DataContext>
        <vm:IntroducirCodigoVM/>
    </UserControl.DataContext>

    <Grid>

        <Grid.Background>
            <ImageBrush ImageSource="/Assets/fondo.png" Stretch="UniformToFill"/>
        </Grid.Background>

        <Button Content="←"
        Width="40"
        Height="40"
        FontSize="20"
        FontWeight="Bold"
        Background="#5ECF85"
        Foreground="White"
        BorderBrush="#4CAF50"
        BorderThickness="2"
        Cursor="Hand"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Margin="20"
        Command="{Binding VolverCommand}"/>

        <Border Width="500"
        Padding="40"
        CornerRadius="25"
        Background="#CCFFFFFF"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">

            <StackPanel>

                <Image Source="/Assets/logo.png"
       Width="90"
       Height="90"
       Margin="0,0,0,20"
       HorizontalAlignment="Center"/>

                <TextBlock Text="Introduce el código"
           FontSize="26"
           FontWeight="Bold"
           Foreground="#2E7D32"
           HorizontalAlignment="Center"
           Margin="0,0,0,20"/>

                <TextBlock Text="Hemos enviado un código a tu correo."
           TextAlignment="Center"
           Margin="0,0,0,20"/>

                <TextBox Height="40"
         FontSize="16"
         Padding="10"
         BorderBrush="#4CAF50"
         BorderThickness="2"
         Text="{Binding CodigoUsuario}"/>

                <Button Content="Verificar código"
        Height="45"
        Margin="0,20,0,0"
        Background="#4CAF50"
        Foreground="White"
        FontWeight="Bold"
        Command="{Binding VerificarCodigoCommand}"/>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>