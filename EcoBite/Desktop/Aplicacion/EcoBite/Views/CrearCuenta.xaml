<UserControl x:Class="EcoBite.Views.CrearCuenta"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:EcoBite.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="900">

    <UserControl.DataContext>
        <vm:CrearCuentaVM/>
    </UserControl.DataContext>

    <UserControl.Resources>

        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#2E7D32"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#4CAF50"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
        </Style>

        <Style x:Key="FormPasswordStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#4CAF50"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
        </Style>

    </UserControl.Resources>

    <Grid>

        <Grid.Background>
            <ImageBrush ImageSource="/Assets/fondo.png"
                        Stretch="UniformToFill"/>
        </Grid.Background>

        <Rectangle Fill="#663C7E64"/>

        <Grid Margin="40">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>




            <!-- FORMULARIO -->
            <Border Grid.Row="1"
                    Width="700"
                    Padding="40"
                    CornerRadius="25"
                    Background="#CCFFFFFF"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>
                    <!-- HEADER-->
                    <Grid  Grid.Row="0" Margin="0,0,0,25" >

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- BOTON VOLVER -->
                        <Button Content="←"
                                Width="45"
                                Height="45"
                                FontSize="20"
                                Background="#22FFFFFF"
                                BorderThickness="0"
                                Foreground="Black"
                                Command="{Binding VolverCommand}"/>

                        <!-- LOGO -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">

                            <Grid Width="100" Height="100">

                                <Ellipse Fill="White" Margin="0,0,10,10"/>

                                <Ellipse Fill="#2E7D32"
                                         HorizontalAlignment="Right"
                                         Width="90"
                                         Margin="0,0,10,19">

                                    <Ellipse.OpacityMask>
                                        <ImageBrush ImageSource="/Assets/logo.png"
                                                    Stretch="Uniform"/>
                                    </Ellipse.OpacityMask>

                                </Ellipse>

                            </Grid>

                        </StackPanel>

                    </Grid>
                    <!--HEADER-->
                    <Grid Margin="0,0,0,20">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- IZQUIERDA -->
                        <StackPanel Grid.Column="0" Margin="0,0,15,0">

                            <TextBlock Text="Nombre"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <TextBox Style="{StaticResource FormTextBoxStyle}"
                                     Text="{Binding Nombre}"/>

                            <TextBlock Text="Email"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <TextBox Style="{StaticResource FormTextBoxStyle}"
                                     Text="{Binding Email}"/>

                            <TextBlock Text="Teléfono"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <TextBox Style="{StaticResource FormTextBoxStyle}"
                                     Text="{Binding Telefono}"/>

                            <TextBlock Text="Ubicación"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <TextBox Style="{StaticResource FormTextBoxStyle}"
                                     Text="{Binding Ubicacion}"/>

                            <TextBlock Text="Horario"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <TextBox Style="{StaticResource FormTextBoxStyle}"
                                     Text="{Binding Horario}"/>

                        </StackPanel>

                        <!-- DERECHA -->
                        <StackPanel Grid.Column="1" Margin="15,0,0,0">

                            <TextBlock Text="Contraseña"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <PasswordBox Style="{StaticResource FormPasswordStyle}"
                                         PasswordChanged="PasswordChanged"/>

                            <TextBlock Text="Confirmar contraseña"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <PasswordBox Style="{StaticResource FormPasswordStyle}"
                                         PasswordChanged="ConfirmarPasswordChanged"/>

                            <TextBlock Text="Descripción"
                                       Style="{StaticResource FormLabelStyle}"/>

                            <TextBox Height="80"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     Text="{Binding Descripcion}"/>

                            <Button Content="Seleccionar imagen"
                                    Height="35"
                                    Command="{Binding SeleccionarImagenCommand}"
                                    Margin="0,5,0,10"/>

                            <Border Height="120"
                                    CornerRadius="10"
                                    Background="#EEEEEE"
                                    ClipToBounds="True">

                                <Image Source="{Binding Imagen, Converter={StaticResource Base64ToImageConverter}}"
                                       Stretch="UniformToFill"/>

                            </Border>

                        </StackPanel>

                    </Grid>

                    <Button Content="Crear cuenta"
                            Width="240"
                            Height="45"
                            FontSize="18"
                            FontWeight="Bold"
                            Background="#5ECF85"
                            Foreground="White"
                            BorderBrush="#4CAF50"
                            BorderThickness="2"
                            HorizontalAlignment="Center"
                            Command="{Binding ConfirmarCommand}"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>